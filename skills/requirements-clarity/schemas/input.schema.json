{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdd.local/skills/requirements-clarity/input.schema.json",
  "title": "RequirementsClarityInput",
  "type": "object",
  "additionalProperties": false,
  "required": ["request"],
  "properties": {
    "request": {
      "type": "string",
      "minLength": 1,
      "description": "用户原始需求描述"
    },
    "project_context": {
      "type": "object",
      "description": "项目上下文摘要；不得包含凭证",
      "additionalProperties": true
    },
    "constraints": {
      "type": "array",
      "description": "已知业务、技术、时间或安全约束",
      "items": { "type": "string", "minLength": 1 },
      "default": []
    },
    "existing_requirements": {
      "type": "array",
      "description": "已有需求或 Artifact 引用；字符串形式保留旧输入兼容",
      "items": {
        "oneOf": [
          { "type": "string", "minLength": 1 },
          { "$ref": "#/$defs/artifactRef" }
        ]
      },
      "default": []
    },
    "change_request": {
      "$ref": "#/$defs/changeRequest"
    }
  },
  "$defs": {
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "version", "sha256", "type"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "type": {
          "type": "string",
          "enum": ["requirements", "analysis", "design", "plan", "report", "other"]
        }
      }
    },
    "changeRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "requested_changes"],
      "properties": {
        "reason": { "type": "string", "minLength": 1 },
        "requested_changes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "previous_requirements": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifactRef" }
        }
      }
    }
  }
}
