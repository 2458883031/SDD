      "design_summary": {
        "description": "订单列表组合筛选功能的完整系统设计，包含架构变更、数据迁移和零停机部署方案。",
        "goal": "支持按状态、时间、金额范围组合筛选订单，p95 < 500ms，零停机部署。",
        "scope": [
          "订单查询服务架构",
          "数据库索引",
          "API 版本管理",
          "迁移脚本",
          "回滚方案"
        ],
        "non_goals": [
          "不增加新订单状态",
          "不修改支付流程"
        ]
      },
      "selected_solution": "SOL-A",
      "alternatives": [
        {
          "name": "新建独立筛选服务",
          "reason_for_rejection": "跨服务调用增加延迟，运维复杂度高"
        },
        {
          "name": "全量数据客户端过滤",
          "reason_for_rejection": "大数据量下性能不可接受"
        },
        {
          "name": "物化视图预计算",
          "reason_for_rejection": "存储成本高，实时更新复杂"
        }
      ],
      "decisions": [
        {
          "decision_id": "DEC-1",
          "decision": "订单查询服务增加 v2 接口，v1 保留向后兼容。",
          "rationale": "零停机部署要求：新接口上线后逐步迁移客户端。",
          "alternatives_considered": [
            {
              "name": "原地修改 v1 接口",
              "reason_for_rejection": "不兼容变更，需停机"
            },
            {
              "name": "直接废弃 v1",
              "reason_for_rejection": "影响现有客户端"
            }
          ],
          "related_requirements": [
            "FR-1",
            "NFR-1"
          ],
          "related_analysis": [
            "SOL-A"
          ],
          "consequences": [
            "需维护双版本",
            "需客户端迁移计划"
          ],
          "decision_level": "key"
        },
        {
          "decision_id": "DEC-2",
          "decision": "为 status/time/amount 字段创建复合索引。",
          "rationale": "满足 p95 < 500ms 性能要求。",
          "alternatives_considered": [
            {
              "name": "全表扫描",
              "reason_for_rejection": "性能不达标"
            },
            {
              "name": "单独索引",
              "reason_for_rejection": "组合查询效率低"
            }
          ],
          "related_requirements": [
            "NFR-1"
          ],
          "related_analysis": [
            "SOL-A"
          ],
          "consequences": [
            "索引创建需在线 DDL",
            "写入性能轻微下降"
          ],
          "decision_level": "key"
        },
        {
          "decision_id": "DEC-3",
          "decision": "筛选面板使用 Debounce 300ms。",
          "rationale": "减少频繁请求。",
          "decision_level": "lightweight"
        }
      ],
      "architecture_overview": {
        "description": "前端筛选面板 → 订单查询服务 v2 → PostgreSQL (复合索引)；v1 接口保留兼容。",
        "system_boundary": "订单查询服务边界扩展，新增 v2 接口。",
        "deployment_view": "容器化部署，蓝绿发布支持零停机。",
        "runtime_view": "查询请求经 API Gateway 路由到 v1/v2。",
        "external_systems": [
          "PostgreSQL",
          "API Gateway",
          "订单列表前端"
        ]
      },
      "modules": [
